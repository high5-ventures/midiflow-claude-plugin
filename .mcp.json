{
  "mcpServers": {
    "midiflow": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/start.sh",
        "--plugin-dir",
        "${user_config.extra_plugin_dirs}",
        "--input-dir",
        "${user_config.allowed_input_dirs}",
        "--instrument-dir",
        "${user_config.instrument_dirs}"
      ],
      "env": {
        "CLAUDE_PLUGIN_OPTION_OUTPUT_DIR": "${user_config.output_dir}",
        "CLAUDE_PLUGIN_OPTION_PREFERRED_FORMAT": "${user_config.preferred_format}",
        "CLAUDE_PLUGIN_OPTION_MAX_PARALLEL_RENDERS": "${user_config.max_parallel_renders}",
        "CLAUDE_PLUGIN_OPTION_NOTE_NAME_CONVENTION": "${user_config.note_name_convention}",
        "CLAUDE_PLUGIN_OPTION_OVERLOAD_MODE": "${user_config.overload_mode}"
      }
    }
  }
}
